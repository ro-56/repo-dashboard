FROM debian:stable-slim

# Timezone
ARG TZ=America/Sao_Paulo
ENV TZ=${TZ}

# Base tools + Tauri v2 system dependencies (Linux/amd64)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    file \
    build-essential \
    libssl-dev \
    pkg-config \
    libwebkit2gtk-4.1-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libsoup-3.0-dev \
    patchelf \
    tzdata \
    && ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime \
    && echo ${TZ} > /etc/timezone \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Node.js LTS (v24.x)
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install pnpm
RUN npm install -g pnpm

ARG USERNAME=devuser

RUN useradd -m -s /bin/bash ${USERNAME}

# Set DEVCONTAINER environment variable to help with orientation
ENV DEVCONTAINER=true

RUN mkdir -p /workspace && \
    chown -R ${USERNAME} /workspace

WORKDIR /workspace

USER ${USERNAME}

# Install Rust (stable) via rustup
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --no-modify-path
ENV PATH="/home/${USERNAME}/.cargo/bin:${PATH}"

# Install Taskr (pre-built binary, installs to ~/.local/bin)
RUN curl -fsSL https://raw.githubusercontent.com/ro-56/taskr/main/install.sh | bash
ENV PATH="/home/${USERNAME}/.local/bin:${PATH}"

# Install Claude Code CLI
RUN curl -fsSL https://claude.ai/install.sh | bash
